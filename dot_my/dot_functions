# Copy with confirmation
# Copy to clipboard (renamed from 'copy' to avoid conflict with cp plugin)
clip() {
  if [[ -t 0 ]]; then
    echo -n "$*" | pbcopy && echo "✅ Copied to clipboard"
  else
    pbcopy && echo "✅ Copied to clipboard"
  fi
}

# Copy file content
copyfile() {
  if [[ -z "$1" ]] || [[ ! -f "$1" ]]; then
    echo "Usage: copyfile <file>"
    return 1
  fi
  cat "$1" | pbcopy
  echo "✅ Copied $1 to clipboard"
}

# Copy current directory path
copypath() {
  pwd | tr -d '\n' | pbcopy
  echo "✅ Copied: $(pwd)"
}
