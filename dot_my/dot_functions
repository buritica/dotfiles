# Helper: Get the deployed Brewfile path. The Brewfile is OWNED by the machines
# ansible repo and deployed to ~/.config/homebrew/Brewfile by the packages role;
# the read-only audit helpers below check installed packages against it.
_get_brewfile_path() {
    echo "${HOMEBREW_BUNDLE_FILE:-$HOME/.config/homebrew/Brewfile}"
}

# Guard: the read-only audit helpers need the deployed Brewfile to exist. On a
# machine that hasn't run the packages role yet it won't — bail with a clear
# message instead of letting grep spew errors and lie about "(none) missing".
_require_brewfile() {
    local f; f=$(_get_brewfile_path)
    [[ -f "$f" ]] && return 0
    echo "No Brewfile at $f — run the machines packages role first (ansible-playbook ... --tags packages)." >&2
    return 1
}

# Edit the Brewfile — now owned by the machines ansible repo, not dotfiles.
brew-edit() {
    local src="$HOME/src/machines/ansible/roles/packages/files/Brewfile"
    if [[ -f "$src" ]]; then
        ${=EDITOR:-vi} "$src"   # ${=...} word-splits so EDITOR="code -w" works
    else
        echo "The Brewfile lives in the machines ansible repo:"
        echo "  ansible/roles/packages/files/Brewfile"
        echo "Edit it there, then run: ansible-playbook ansible/playbooks/provision.yml --tags packages"
    fi
}

# Show what's installed but not in Brewfile
brew-installed-only() {
    _require_brewfile || return 1
    local brewfile
    brewfile=$(_get_brewfile_path)

    echo "📦 Formulas installed but not in Brewfile:"
    comm -13 \
        <(grep '^brew "' "$brewfile" | sed 's/brew "\([^"]*\)".*/\1/' | sort) \
        <(brew list --formula | sort) | \
        grep -v "^$(brew deps --installed --formula | sort -u | paste -sd "|" -)$" || echo "  (none)"

    echo ""
    echo "🖥️  Casks installed but not in Brewfile:"
    comm -13 \
        <(grep '^cask "' "$brewfile" | sed 's/cask "\([^"]*\)".*/\1/' | sort) \
        <(brew list --cask | sort) || echo "  (none)"
}

# Show what's in Brewfile but not installed
brew-missing() {
    _require_brewfile || return 1
    local brewfile
    brewfile=$(_get_brewfile_path)

    echo "📦 Formulas in Brewfile but not installed:"
    comm -23 \
        <(grep '^brew "' "$brewfile" | sed 's/brew "\([^"]*\)".*/\1/' | sort) \
        <(brew list --formula | sort) || echo "  (none)"

    echo ""
    echo "🖥️  Casks in Brewfile but not installed:"
    comm -23 \
        <(grep '^cask "' "$brewfile" | sed 's/cask "\([^"]*\)".*/\1/' | sort) \
        <(brew list --cask | sort) || echo "  (none)"
}

# Show diff between Brewfile and installed packages
brew-diff() {
    _require_brewfile || return 1   # bail once, before the sub-helpers double-print it
    echo "=== Brewfile vs Installed Packages ==="
    echo ""
    brew-installed-only
    echo ""
    brew-missing
}

# brew-sync is retired: the Brewfile is owned by the machines ansible repo, so
# syncing installed packages back into a dotfiles-managed Brewfile no longer
# applies (it would edit the deployed copy, which the next provision overwrites).
brew-sync() {
    echo "ℹ️  brew-sync is retired — packages are owned by the machines ansible repo."
    echo "   Audit installed vs Brewfile:  brew-diff"
    echo "   Edit the source Brewfile:     brew-edit"
    echo "   Apply:  ansible-playbook ansible/playbooks/provision.yml --limit <hostname> --tags packages"
}

# Safe process grep with modern tool
psg() {
    if [ $# -eq 0 ]; then
        echo "Usage: psg <search_term>"
        return 1
    fi
    procs --or "${@}" 2>/dev/null || ps aux | grep -v grep | grep -i --color=auto "${@}"
}

# Safe npm clean with confirmation
unalias npm-clean 2>/dev/null || true  # Remove old alias if it exists
npm-clean() {
    echo "This will delete node_modules and reinstall. Continue? [y/N]"
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
        rm -rf ./node_modules && npm install
    else
        echo "Cancelled"
    fi
}

# Export current installation to a Brewfile snapshot (read-only, for reference).
# Writes to /tmp — it does NOT touch the machines-owned Brewfile. Use the output
# to update ansible/roles/packages/files/Brewfile in the machines repo by hand.
brew-export() {
    local out="${1:-/tmp/Brewfile.snapshot}"
    # Never dump over the machines-owned Brewfile — that's the footgun this
    # whole split exists to prevent (the next provision would overwrite it anyway).
    if [[ "$out" == *"/packages/files/Brewfile" || "$out" == "$(_get_brewfile_path)" ]]; then
        echo "❌ Refusing to write to the machines-owned Brewfile ($out). Pick a scratch path." >&2
        return 1
    fi
    echo "📝 Dumping current installation to $out ..."
    if ! brew bundle dump --file="$out" --force; then
        echo "❌ Failed to generate Brewfile snapshot"
        return 1
    fi
    echo "✅ Snapshot written to $out"
    echo "   The authoritative Brewfile lives in the machines repo: ansible/roles/packages/files/Brewfile"
}

# Detect orphaned packages (optimized with zsh arrays)
brew-orphans() {
  echo "🔍 Checking for orphaned packages..."

  local -a installed leaves all_deps orphans

  # Build arrays once
  installed=(${(f)"$(brew list --formula)"})
  leaves=(${(f)"$(brew leaves)"})
  all_deps=(${(f)"$(brew deps --installed --formula)"})

  # Find packages that are neither leaves nor dependencies
  for package in $installed; do
    if [[ ! ${leaves[(ie)$package]} -le ${#leaves} ]] &&
       [[ ! ${all_deps[(ie)$package]} -le ${#all_deps} ]]; then
      orphans+=($package)
    fi
  done

  if (( ${#orphans} > 0 )); then
    echo "  📦 Found ${#orphans} orphaned package(s):"
    printf '  %s\n' "${orphans[@]}"
  else
    echo "  ✨ No orphaned packages found"
  fi
}

# Clean up brew cache
brew-cleanup() {
    echo "🧹 Cleaning up Homebrew..."
    brew cleanup --prune=all
    brew autoremove
    echo "✅ Cleanup complete"
}

# =============================================================================
# Dotfiles Workflow Helpers
# =============================================================================
# Simplify common chezmoi operations to reduce knowledge required

# Pull and apply latest changes from dotfiles repo
dotfiles-sync() {
    chezmoi update
}

# Apply pending changes without pulling
dotfiles-apply() {
    chezmoi apply
}

# Show what would change
dotfiles-diff() {
    chezmoi diff
}

# Edit a dotfile in the source directory
dotfiles-edit() {
    if [ -z "$1" ]; then
        echo "Usage: dotfiles-edit <file>"
        echo "Example: dotfiles-edit ~/.zshrc"
        return 1
    fi
    chezmoi edit "$1"
}

# Add a file to dotfiles tracking
dotfiles-add() {
    if [ -z "$1" ]; then
        echo "Usage: dotfiles-add <file>"
        echo "Example: dotfiles-add ~/.myconfig"
        return 1
    fi
    chezmoi add "$1"
}

# Check status of dotfiles
dotfiles-status() {
    chezmoi status
}

# Go to dotfiles source directory
dotfiles-cd() {
    cd "$(chezmoi source-path)"
}

# Re-run setup script
dotfiles-setup() {
    "$(chezmoi source-path)/setup.sh"
}

