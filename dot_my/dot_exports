# default editor and alias
export EDITOR='code -w'

# Larger bash history (allow 32³ entries; default is 500)
export HISTSIZE=32768;
export HISTFILESIZE=$HISTSIZE;
export HISTCONTROL=ignoredups;

# Make some commands not show up in history
export HISTIGNORE="ls:cd:cd -:pwd:exit:date:* --help";

# Prefer US English and use UTF-8
export LANG="en_US.UTF-8";
export LC_ALL="en_US.UTF-8";

# Highlight section titles in manual pages with bat
export MANPAGER='sh -c "col -bx | bat -l man -p"'
export MANROFFOPT='-c'  # Fix formatting issues

# Colors for ghi and others
export TERM="xterm-256color"

# Gopath
export GOPATH="$HOME/go"

# Brewfile — owned by the machines ansible repo (roles/packages), deployed to
# ~/.config/homebrew/Brewfile. Deliberately NOT exported: a shell-wide
# HOMEBREW_BUNDLE_FILE turns a bare `brew bundle`/`brew bundle cleanup` into a
# state-changing command in every directory. The read-only brew-* helpers fall
# back to that path via _get_brewfile_path's default, which is all they need.

# 1Password ssh agent
if [[ -S "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" ]]; then
  export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
fi

# gws: file-backed credential key, so gws works over SSH. With the macOS
# keyring, gws over SSH can't decrypt and deletes the credentials.
export GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND=file
