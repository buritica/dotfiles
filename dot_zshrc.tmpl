# Start timing shell initialization (using zsh's EPOCHREALTIME for fractional seconds)
typeset -F SECONDS
_zsh_start_time=$SECONDS

# Enable profiling to find bottlenecks (set ZSH_PROFILE=1 to enable)
if [[ -n "$ZSH_PROFILE" ]]; then
  zmodload zsh/zprof
fi

# =============================================================================
# Oh My Zsh Configuration
# =============================================================================

# Theme + plugin set is the shared zsh base (dot_config/zsh-base), the same
# one the estanli account on severo loads.
# Completion cache settings (improves startup time); Oh My Zsh runs compinit.
export ZSH_COMPDUMP="${ZDOTDIR:-$HOME}/.zcompdump"
[ -r "$HOME/.config/zsh-base/omz.zsh" ] && source "$HOME/.config/zsh-base/omz.zsh"

# =============================================================================
# Path Configuration
# =============================================================================

# .zshenv set the canonical PATH, but in login shells macOS /etc/zprofile runs
# path_helper afterwards and moves the system dirs to the front. Re-apply it.
# Hosts without path.zsh keep .zshenv's fallback, as path_helper left it.
[[ -r "$HOME/.config/shell/path.zsh" ]] && source "$HOME/.config/shell/path.zsh"

# =============================================================================
# Tool Initialization with Lazy Loading
# =============================================================================
# Using zsh-defer for lazy loading to improve shell startup time
# Target: < 100ms startup (2-3x improvement from ~150-300ms)

# Load zsh-defer first (managed by chezmoi via .chezmoiexternal.toml)
if [ -f "${HOME}/.oh-my-zsh/custom/plugins/zsh-defer/zsh-defer.plugin.zsh" ]; then
    source "${HOME}/.oh-my-zsh/custom/plugins/zsh-defer/zsh-defer.plugin.zsh"
fi

# direnv initialization (keep eager - needed for project contexts)
if command -v direnv >/dev/null 2>&1; then
    eval "$(direnv hook zsh)"
fi

# mise is activated system-wide via /etc/zshrc (managed by ansible).
# No per-user activation needed here.

# =============================================================================
# Modern Tool Initialization
# =============================================================================

# fzf configuration (defer - only needed when fuzzy finding)
if command -v fzf >/dev/null 2>&1; then
    # Export environment variables immediately (needed for command availability)
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
    export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:500 {}'"
    export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --icons {}'"
    export FZF_DEFAULT_OPTS='--color=bg+:#3e3d32,bg:#272822,spinner:#e6db74,hl:#a6e22e --color=fg:#f8f8f2,header:#a6e22e,info:#e6db74,pointer:#e6db74 --color=marker:#e6db74,fg+:#f8f8f2,prompt:#e6db74,hl+:#a6e22e'

    # Key bindings + completion (Ctrl+R, Ctrl+T, Alt+C) straight from fzf
    # (>= 0.48), not ~/.fzf.zsh, which only fzf's own install script writes.
    if command -v zsh-defer >/dev/null 2>&1; then
        zsh-defer -c 'source <(fzf --zsh)'
    else
        source <(fzf --zsh)
    fi
fi

# zoxide initialization (defer - only needed when using z command)
if command -v zoxide >/dev/null 2>&1; then
    if command -v zsh-defer >/dev/null 2>&1; then
        zsh-defer -c 'eval "$(zoxide init zsh)"'
    else
        eval "$(zoxide init zsh)"
    fi
fi

# bat configuration
if command -v bat >/dev/null 2>&1; then
    export BAT_THEME="Monokai Extended"
    export BAT_PAGER="less -FR"
    alias -g -- --help='--help 2>&1 | bat --plain --language=help'
fi

# eza configuration
if command -v eza >/dev/null 2>&1; then
    export EZA_COLORS="da=37:di=34:ln=36:ex=32"
fi

# ripgrep configuration
if command -v rg >/dev/null 2>&1; then
    export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"
fi

# bun completions (bun writes ~/.bun/_bun itself on install/upgrade)
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# =============================================================================
# Shell Configuration
# =============================================================================

# Load the shell dotfiles; the shared base functions (dot_config/zsh-base) load
# after the aliases, same order as before they moved there
for file in ~/.my/.{exports,aliases} ~/.config/zsh-base/functions.zsh ~/.my/.functions; do
    [ -r "$file" ] && [ -f "$file" ] && source "$file"
done
unset file

# Set file size limit
ulimit -n 10000

# =============================================================================
# Prompt Configuration
# =============================================================================

# Prompt prefix — host-specific emoji so it's obvious which machine you're on.
{{- if eq .chezmoi.hostname "crowntail" }}
export PS1="🦇 $PS1"
{{- else if eq .chezmoi.hostname "severo" }}
export PS1="🤘 $PS1"
{{- else }}
export PS1="💀 $PS1"
{{- end }}

# =============================================================================
# Aliases and Completions
# =============================================================================

# Alias python to python3 if it exists
if command -v python3 >/dev/null 2>&1; then
    alias python=python3
fi

{{- if eq .chezmoi.hostname "severo" }}
# Tailscale SSH doesn't create a normal PAM/loginwindow security session, so
# `security` over an SSH (Tailscale) connection can't see the real login
# keychain ("user name or passphrase is not correct" even with the right
# password) — while the same command run from a GUI session (e.g. Ghostty)
# works fine. Named separately rather than shadowing `security` itself, since
# routing every call through sudo+asuser would add friction where it's not
# needed. Use only when a plain `security` call fails over SSH.
security-gui() { sudo launchctl asuser "$(id -u buritica)" /usr/bin/security "$@"; }
{{- end }}

# =============================================================================
# Finalization
# =============================================================================

# Calculate and display shell initialization time
_zsh_elapsed=$((($SECONDS - $_zsh_start_time) * 1000))
printf "dotfiles sourced (%dms)\n" $_zsh_elapsed

# Show profiling output if enabled
if [[ -n "$ZSH_PROFILE" ]]; then
  zprof
fi

unset _zsh_start_time _zsh_elapsed